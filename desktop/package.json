{
  "name": "savdo-dokoni",
  "productName": "Savdo do'koni",
  "version": "1.0.0",
  "description": "Oziq-ovqat do'koni uchun sotuv va ombor dasturi",
  "author": "Savdo do'koni",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "uz.savdodokoni.app",
    "productName": "Savdo do'koni",
    "copyright": "Savdo do'koni",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "app/**/*", "build/icon.png"],
    "asar": true,
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Savdo do'koni",
      "artifactName": "Savdo-dokoni-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Savdo-dokoni-portable-${version}.exe"
    }
  }
}
